NODE_ENV=local
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://expoapp:expoapp@localhost:5433/expoapp?schema=public
REDIS_URL=redis://localhost:6380

JWT_SECRET=replace-with-local-dev-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://localhost:5000

FUSION_MODE=mock
FUSION_BASE_URL=
FUSION_CLIENT_ID=
FUSION_CLIENT_SECRET=
FUSION_TOKEN_URL=
FUSION_SCOPE=

PUSH_MODE=mock
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

LOG_LEVEL=debug
